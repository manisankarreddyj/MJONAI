[Unit]
Description=MJONAI Autonomous Algorithmic Trading Execution Engine
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/MJONAI/mjonai-build
EnvironmentFile=/opt/MJONAI/credentials/.env.master
ExecStart=/opt/MJONAI/.venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
