# ==============================================================================
# MJONAI ROOT REPOSITORY .GITIGNORE
# Strict Secret & Large Binary Exclusion Rules
# ==============================================================================

# Credentials & API Keys (CRITICAL - NEVER COMMIT)
# Single canonical env file at repo root (.env) since 2026-09-20;
# .env.example is the committed (non-secret) template.
*.env
*.env.*
.env
.env.*
**/.env
**/.env.*
!.env.example
.git_backup_standalone/
**/.git_backup_standalone/

# Python Virtual Environments
.venv/
venv/
env/
ENV/
.python-version

# Python Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# IDE & Editor Configurations
.vscode/
.idea/
.codex/
.claude/
.agents/*
!.agents/skills/
!.agents/skills/**/SKILL.md
*.swp
*.swo
*~
Thumbs.db
.DS_Store

# Node & Frontend Build Artifacts (frontend/ moved to archive/ 2026-09-03)
archive/frontend/node_modules/
node_modules/
archive/frontend/dist/
archive/frontend/build/
.dart_tool/
build/

# Local Runtime Caches, Databases & Logs (ADR-0008: runtime data at repo root)
*.log
logs/
*.db
*.sqlite
*.sqlite3
mjonai.db
# Angel scrip-master runtime cache (untracked 2026-09-20 — synced snapshot no
# longer versioned; self-heals from Angel master URL when absent)
mjonai/data/angelone/instrument_master_cache.json
cache/*
!cache/.gitkeep
backups/*
!backups/.gitkeep
storage/logs/*
storage/temp/*
storage/exports/*
!storage/logs/.gitkeep
!storage/temp/.gitkeep
!storage/exports/.gitkeep
storage/heartbeat.json
**/storage/heartbeat.json

# Engine runtime journals & state (rewritten daily; persist on disk, never in git)
storage/*.jsonl
storage/*.json
storage/*.bak

# Regenerable research data caches (moved to archive/ 2026-09-03; regenerable via
# data/download_6months_1min.py — large datasets stay out of git)
archive/scratch/angelone_1min_cache/

# Preserved datasets & parquets
storage/parquet/*
storage/duckdb/*
!storage/parquet/.gitkeep
!storage/duckdb/.gitkeep

# Versioned research verdict artifacts (research/evidence.py)
storage/research_evidence/*
!storage/research_evidence/.gitkeep
storage/vendor/*
storage/models/*
!storage/vendor/.gitkeep
!storage/models/.gitkeep
datasets/raw/*
datasets/processed/*
datasets/features/*
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep
!datasets/features/.gitkeep
